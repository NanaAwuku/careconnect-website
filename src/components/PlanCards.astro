---
import { PLANS } from '../data/site';
const money = (n: number) => `$${n.toLocaleString('en-US')}`;
---
<div class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 pt-4 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-5 md:overflow-visible md:px-0 md:pb-0 xl:grid-cols-4">
  {PLANS.map((p) => (
    <div class={`lift relative flex w-[82%] shrink-0 snap-center flex-col rounded-xl p-6 sm:p-7 md:w-auto ${p.highlight ? 'bg-ink text-white' : 'border border-line bg-white'}`}>
      {p.highlight && <span class="absolute -top-3.5 left-7 rounded-md bg-accent px-3 py-1 text-xs font-semibold text-ink">Recommended</span>}
      <h3 class="font-display text-2xl font-extrabold tracking-[-0.03em]">{p.name}</h3>
      <p class={`mt-1 text-sm ${p.highlight ? 'text-white/70' : 'text-ink-soft'}`}>{p.forWho}</p>
      <div class="mt-6">
        {p.monthly === null ? (
          <p class="font-display text-4xl font-extrabold tracking-[-0.03em]">Let's talk</p>
        ) : p.monthly === 0 ? (
          <p class="font-display text-4xl font-extrabold tracking-[-0.03em]">Free</p>
        ) : (
          <p class="font-display text-4xl font-extrabold tracking-[-0.03em]">{money(p.monthly)}<span class={`font-sans text-sm font-normal ${p.highlight ? 'text-white/70' : 'text-ink-soft'}`}> / month</span></p>
        )}
        <p class={`mt-2 text-sm font-semibold ${p.highlight ? 'text-accent' : 'text-brand'}`}>{p.members}</p>
      </div>
      <ul class="mt-7 flex-1 space-y-3 text-sm">
        {p.includes.map((i) => (
          <li class="flex gap-3"><svg viewBox="0 0 20 20" class={`mt-0.5 h-4 w-4 shrink-0 ${p.highlight ? 'text-accent' : 'text-brand'}`} fill="currentColor"><path d="M8.2 13.6 4.9 10.3l-1.4 1.4 4.7 4.7 9-9-1.4-1.4z" /></svg>{i}</li>
        ))}
      </ul>
      <a href={`/request-access?plan=${p.id}`} class={`btn mt-8 w-full ${p.highlight ? 'btn-accent' : p.monthly === null ? 'btn-ghost' : 'btn-primary'}`}>
        {p.monthly === null ? 'Talk to us' : p.monthly === 0 ? 'Start free' : 'Request access'}
      </a>
    </div>
  ))}
</div>

<p class="mt-1 text-center text-xs text-ink-soft md:hidden">Swipe to see every plan</p>
