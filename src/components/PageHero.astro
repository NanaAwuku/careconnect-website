---
// The opening of every inner page: one flat block of colour and a heavy headline.
// `tone` picks the block: dark (white type), gold or pale (dark type).
// An optional picture goes in the "aside" slot; without one the hero is left-aligned and wide.
interface Props { tone?: 'dark' | 'gold' | 'pale'; lede?: string }
const { tone = 'pale', lede } = Astro.props;
const hasAside = Astro.slots.has('aside');
const bg = { dark: 'bg-ink text-white', gold: 'bg-accent text-ink', pale: 'bg-brand-soft text-ink' }[tone];
const ledeColour = tone === 'dark' ? 'text-white/85' : 'text-ink/75';
---
<section class={bg}>
  <div class={`container-page py-16 sm:py-24 ${hasAside ? 'grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]' : ''}`}>
    <div>
      <h1 class="h-display reveal max-w-4xl"><slot /></h1>
      {lede && <p class={`reveal reveal-delay-1 mt-6 max-w-2xl text-lg leading-relaxed sm:text-xl ${ledeColour}`}>{lede}</p>}
      <div class="reveal reveal-delay-2"><slot name="after" /></div>
    </div>
    {hasAside && <div class="reveal reveal-delay-1"><slot name="aside" /></div>}
  </div>
</section>
