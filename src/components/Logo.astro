---
// The CareConnect mark: two arcs meeting — people held together — and the wordmark.
interface Props { light?: boolean; class?: string }
const { light = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2 ${cls}`}>
  <svg viewBox="0 0 32 32" class="h-8 w-8 shrink-0" aria-hidden="true">
    <rect width="32" height="32" rx="9" fill={light ? '#ffffff' : '#0f766e'} />
    <path d="M21.5 10.2a8 8 0 1 0 0 11.6" fill="none" stroke={light ? '#0f766e' : '#ffffff'} stroke-width="3" stroke-linecap="round" />
    <circle cx="22.4" cy="16" r="2.4" fill="#f2a33a" />
  </svg>
  <span class={`text-lg font-extrabold tracking-tight ${light ? 'text-white' : 'text-ink'}`}>CareConnect</span>
</span>
