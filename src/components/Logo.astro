---
// The CareConnect mark: an arc that holds — people gathered — closed by a warm point of light.
interface Props { light?: boolean; class?: string }
const { light = false, class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2.5 ${cls}`}>
  <svg viewBox="0 0 32 32" class="h-9 w-9 shrink-0" aria-hidden="true">
    <rect width="32" height="32" rx="10" fill={light ? '#ffffff' : '#141414'} />
    <path d="M21.5 10.2a8 8 0 1 0 0 11.6" fill="none" stroke={light ? '#141414' : '#ffffff'} stroke-width="3.2" stroke-linecap="round" />
    <circle cx="22.4" cy="16" r="2.5" fill="#ffc72c" />
  </svg>
  <span class={`font-display text-[1.35rem] font-extrabold tracking-[-0.03em] ${light ? 'text-white' : 'text-ink'}`}>CareConnect</span>
</span>
