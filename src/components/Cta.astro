---
import { PHOTOS, unsplash } from '../data/images';
---
<section class="py-24">
  <div class="container-page">
    <div class="reveal relative isolate overflow-hidden rounded-[2.5rem] bg-brand px-8 py-16 text-white sm:px-14 lg:py-20">
      <img src={unsplash(PHOTOS.leader.id, 1200, 800)} alt="" loading="lazy" class="absolute inset-y-0 right-0 -z-10 hidden h-full w-1/2 object-cover opacity-40 mix-blend-luminosity lg:block" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand via-brand to-brand/30"></div>
      <h2 class="h-section max-w-xl">Bring your church onto <span class="italic text-accent">CareConnect</span></h2>
      <p class="mt-5 max-w-lg text-lg text-white/85">Tell us about your church and we'll have it set up at its own address within days.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/request-access" class="btn btn-accent">Request access <span class="arrow">→</span></a>
        <a href="/pricing" class="btn border border-white/40 text-white hover:border-white">See pricing</a>
      </div>
    </div>
  </div>
</section>
