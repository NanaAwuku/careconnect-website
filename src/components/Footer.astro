---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
const year = new Date().getFullYear();
const cols = [
  { title: 'Product', links: [['/features', 'Features'], ['/pricing', 'Pricing'], ['/security', 'Security'], ['/request-access', 'Request access']] },
  { title: 'For churches', links: [['/sign-in', 'Sign in to your church'], ['/pricing#sms', 'SMS bundles'], ['/request-access', 'Book a demo']] },
  { title: 'Legal', links: [['/privacy', 'Privacy'], ['/terms', 'Terms']] },
];
---
<footer class="bg-ink text-white/80">
  <div class="container-page grid gap-8 border-b border-white/10 py-14 lg:grid-cols-[1.3fr_1fr] lg:items-center">
    <h2 class="font-display text-3xl font-medium leading-tight text-white sm:text-4xl">Every person who walks through your doors is someone to <span class="italic text-accent">care for</span>.</h2>
    <div class="flex flex-wrap gap-3 lg:justify-end"><a href="/request-access" class="btn btn-accent">Request access <span class="arrow">→</span></a><a href="/pricing" class="btn border border-white/25 text-white hover:border-white/60">See pricing</a></div>
  </div>
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="space-y-4">
      <Logo light />
      <p class="max-w-xs text-sm leading-relaxed text-white/70">{SITE.tagline}.</p>
      <p class="text-sm text-white/70">{SITE.city}<br /><a class="hover:text-white" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    {cols.map((c) => (
      <div>
        <p class="mb-3 text-sm font-semibold text-white">{c.title}</p>
        <ul class="space-y-2 text-sm">
          {c.links.map(([href, label]) => <li><a class="hover:text-white" href={href}>{label}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-white/50 sm:flex-row sm:justify-between">
      <p>&copy; {year} CareConnect. All rights reserved.</p>
      <p>Made in Ghana, for churches across Africa.</p>
    </div>
  </div>
</footer>
