---
import { FAQS } from '../data/site';
---
<div class="space-y-3">
  {FAQS.map((f) => (
    <details class="group rounded-3xl border border-line bg-white px-6 py-5 transition-colors open:bg-cream">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold">
        {f.q}
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-mist text-xl transition-transform duration-300 group-open:rotate-45 group-open:bg-accent">+</span>
      </summary>
      <p class="mt-3 leading-relaxed text-ink-soft">{f.a}</p>
    </details>
  ))}
</div>
