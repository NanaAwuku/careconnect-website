---
// Drawn, not screenshotted (until there are real screenshots of a demo church): small, crisp pictures of what each part of CareConnect does.
// Names are invented. One picture per feature id (see data/site.ts), plus the hero dashboard.
interface Props { kind: string }
const { kind } = Astro.props;

const people = [
  { n: 'Ama Owusu', c: 'Shepherd, Monday-January', i: 'AO', t: 'bg-brand-soft text-brand-dark' },
  { n: 'Kwame Mensah', c: 'Choir', i: 'KM', t: 'bg-accent-soft text-amber-800' },
  { n: 'Efua Boateng', c: 'Ushering', i: 'EB', t: 'bg-sky-50 text-sky-800' },
  { n: 'Kojo Asante', c: 'Youth ministry', i: 'KA', t: 'bg-rose-50 text-rose-800' },
];
---
<div class="relative">
  <div class="overflow-hidden rounded-xl border border-line bg-white">
    <div class="flex items-center gap-2.5 border-b border-line px-4 py-3">
      <span class="flex h-6 w-6 items-center justify-center rounded-md bg-ink text-[10px] font-extrabold text-white">GC</span>
      <span class="text-xs font-bold">Grace Chapel</span>
      <span class="ml-auto flex h-6 w-6 items-center justify-center rounded-full bg-brand-soft text-[9px] font-bold text-brand-dark">AO</span>
    </div>
    <div class="p-4 sm:p-5">

      {kind === 'hero' && (
        <div class="grid gap-3">
          <div class="grid grid-cols-3 gap-2.5">
            {[['Members', '1,284'], ['First-timers this month', '37'], ['Due a visit', '12']].map(([l, v]) => (
              <div class="rounded-xl border border-line p-3"><p class="text-[10px] text-ink-soft">{l}</p><p class="text-xl font-extrabold">{v}</p></div>
            ))}
          </div>
          <div class="rounded-xl border border-line p-3">
            <div class="mb-2 flex items-center justify-between"><p class="text-xs font-bold">Sunday attendance</p><p class="text-[10px] text-brand">+8% this quarter</p></div>
            <div class="flex h-24 items-end gap-1.5">
              {[48, 52, 50, 61, 58, 66, 63, 71, 69, 76, 74, 82].map((h) => <div class="flex-1 rounded-t bg-brand/80" style={`height:${h}%`}></div>)}
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2.5">
            <div class="rounded-xl bg-accent-soft p-3"><p class="text-[10px] font-semibold text-amber-800">Second-timer</p><p class="text-xs font-bold">Esi Quaye came back</p><p class="text-[10px] text-ink-soft">Visit due Saturday</p></div>
            <div class="rounded-xl bg-brand-soft p-3"><p class="text-[10px] font-semibold text-brand-dark">SMS sent</p><p class="text-xs font-bold">Reminder to 1,190 people</p><p class="text-[10px] text-ink-soft">1,176 delivered</p></div>
          </div>
        </div>
      )}

      {kind === 'members' && (
        <div class="space-y-2">
          <div class="flex items-center justify-between"><p class="text-sm font-bold">Monday-January chapel</p><span class="rounded-full bg-brand-soft px-2.5 py-1 text-[10px] font-semibold text-brand-dark">42 members</span></div>
          {people.map((p, idx) => (
            <div class="flex items-center gap-3 rounded-xl border border-line px-3 py-2.5">
              <span class={`flex h-8 w-8 items-center justify-center rounded-full text-[11px] font-bold ${p.t}`}>{p.i}</span>
              <div class="min-w-0 flex-1"><p class="truncate text-xs font-semibold">{p.n}</p><p class="text-[10px] text-ink-soft">{p.c}</p></div>
              <span class="font-mono text-[10px] text-ink-soft">GCIMONJAN00{idx + 1}</span>
            </div>
          ))}
        </div>
      )}

      {kind === 'visitors' && (
        <div class="space-y-2.5">
          <p class="text-sm font-bold">Due a visit</p>
          {[
            ['Second-timer', 'Esi Quaye', 'Came twice in three weeks', 'bg-accent-soft text-amber-800'],
            ['Wants to join', 'Yaw Ofori', 'Said yes on his first visit', 'bg-brand-soft text-brand-dark'],
            ['Drifting', 'Abena Sarpong', 'Missed the last 3 Sundays', 'bg-rose-50 text-rose-800'],
          ].map(([tag, name, why, cls]) => (
            <div class="rounded-xl border border-line p-3">
              <div class="flex items-center justify-between"><p class="text-xs font-semibold">{name}</p><span class={`rounded-full px-2 py-0.5 text-[10px] font-semibold ${cls}`}>{tag}</span></div>
              <p class="mt-0.5 text-[11px] text-ink-soft">{why}</p>
              <div class="mt-2 flex gap-1.5"><span class="rounded-lg bg-brand px-2.5 py-1 text-[10px] font-semibold text-white">I'll go</span><span class="rounded-lg border border-line px-2.5 py-1 text-[10px]">Record visit</span></div>
            </div>
          ))}
        </div>
      )}

      {kind === 'attendance' && (
        <div class="grid gap-3 sm:grid-cols-[1fr_1.1fr]">
          <div class="flex flex-col items-center justify-center rounded-xl bg-ink p-5 text-center text-white">
            <p class="text-[10px] uppercase tracking-widest text-white/60">Sunday Service</p>
            <p class="mt-1 text-lg font-extrabold">Welcome</p>
            <div class="my-3 grid h-20 w-20 grid-cols-5 gap-0.5 rounded-lg bg-white p-1.5">{Array.from({ length: 25 }).map((_, i) => <span class={(i * 7) % 3 ? 'bg-ink' : 'bg-white'}></span>)}</div>
            <p class="text-[10px] text-white/70">Scan to check in</p>
          </div>
          <div class="space-y-2">
            {[['Present', 412, 'bg-brand'], ['Late', 38, 'bg-accent'], ['Visitors', 21, 'bg-sky-500']].map(([l, n, c]) => (
              <div class="rounded-xl border border-line p-3"><div class="flex justify-between text-xs"><span class="font-semibold">{l}</span><span>{n}</span></div><div class="mt-1.5 h-1.5 rounded-full bg-mist"><div class={`h-1.5 rounded-full ${c}`} style={`width:${Math.min(100, Number(n) / 4.5)}%`}></div></div></div>
            ))}
          </div>
        </div>
      )}

      {kind === 'messages' && (
        <div class="space-y-3">
          <div class="rounded-xl border border-line p-3">
            <p class="text-[10px] text-ink-soft">From</p><p class="text-xs font-semibold">GRACECHAPEL</p>
            <p class="mt-2 text-[10px] text-ink-soft">To</p><p class="text-xs font-semibold">All members, 1,190 people</p>
            <div class="mt-2 rounded-lg bg-mist p-2.5 text-xs leading-relaxed">Join us this Sunday at 9am for our harvest thanksgiving. Bring a friend! God bless you.</div>
            <div class="mt-2 flex justify-between text-[10px] text-ink-soft"><span>118 characters, 1 SMS each</span><span>1,190 units</span></div>
          </div>
          <div class="flex gap-2">
            <div class="flex-1 rounded-xl bg-brand-soft p-3"><p class="text-lg font-extrabold text-brand-dark">1,176</p><p class="text-[10px] text-ink-soft">Delivered</p></div>
            <div class="flex-1 rounded-xl bg-rose-50 p-3"><p class="text-lg font-extrabold text-rose-700">14</p><p class="text-[10px] text-ink-soft">Not delivered: resend</p></div>
          </div>
        </div>
      )}

      {kind === 'programmes' && (
        <div class="rounded-xl border-2 border-accent/60 p-5 text-center">
          <p class="text-[10px] uppercase tracking-[0.2em] text-ink-soft">Certificate of completion</p>
          <p class="mt-2 text-lg font-extrabold">Akosua Darko</p>
          <p class="text-xs text-ink-soft">has completed</p>
          <p class="text-sm font-bold text-brand-dark">Foundation Class, Season 3</p>
          <div class="mt-4 flex items-end justify-between text-[10px] text-ink-soft"><span>12 of 12 sessions</span><span class="font-mono">FC-S3-0042</span></div>
          <p class="mt-2 text-[10px] text-brand">Verify at gracechapel.careconnect.com/verify</p>
        </div>
      )}

      {kind === 'outreach' && (
        <div class="space-y-2">
          <div class="flex items-center justify-between"><p class="text-sm font-bold">Campus outreach, KNUST</p><span class="text-[10px] text-ink-soft">186 reached</span></div>
          {[['Group A, Unity Hall', 'Pastor Eric', 42], ['Group B, Republic Hall', 'Sis. Adwoa', 38], ['Group C, Africa Hall', 'Bro. Nana', 51]].map(([g, f, n]) => (
            <div class="flex items-center justify-between rounded-xl border border-line px-3 py-2.5"><div><p class="text-xs font-semibold">{g}</p><p class="text-[10px] text-ink-soft">Facilitator: {f}</p></div><span class="text-xs font-bold">{n}</span></div>
          ))}
          <div class="rounded-xl bg-brand-soft p-3 text-[11px]"><b class="text-brand-dark">23 came to church</b> after the outreach</div>
        </div>
      )}

      {kind === 'insight' && (
        <div class="space-y-3">
          <div class="ml-auto max-w-[85%] rounded-lg rounded-br-md bg-brand px-3.5 py-2.5 text-xs text-white">How many first-timers came back this month?</div>
          <div class="max-w-[90%] rounded-lg rounded-bl-md bg-mist px-3.5 py-2.5 text-xs leading-relaxed">
            <b>14 of 37</b> first-timers this month have visited again (38%). The Friday chapel brought the most back: 5.
          </div>
          <div class="grid grid-cols-7 gap-1">{['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d, i) => <div class="text-center"><div class="mx-auto mb-1 w-full rounded bg-brand/70" style={`height:${[18, 26, 22, 30, 44, 20, 36][i]}px`}></div><span class="text-[9px] text-ink-soft">{d}</span></div>)}</div>
        </div>
      )}
    </div>
  </div>
</div>
