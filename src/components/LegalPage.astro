---
import Base from '../layouts/Base.astro';
interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<Base title={title}>
  <article class="container-page max-w-3xl py-16">
    <p class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">Draft for review: this page must be checked by a lawyer before CareConnect launches publicly.</p>
    <h1 class="mt-8 text-4xl font-extrabold tracking-tight">{title}</h1>
    <p class="mt-2 text-sm text-ink-soft">Last updated {updated}</p>
    <div class="legal mt-10 space-y-6 text-[15px] leading-relaxed text-ink-soft [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-ink [&_li]:ml-5 [&_li]:list-disc [&_ul]:space-y-1.5">
      <slot />
    </div>
  </article>
</Base>
