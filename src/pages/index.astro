---
import Base from '../layouts/Base.astro';
import PlanCards from '../components/PlanCards.astro';
import Faq from '../components/Faq.astro';
import FeatureTabs from '../components/FeatureTabs.astro';
import { STEPS } from '../data/site';
import { PHOTOS, unsplash } from '../data/images';

const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
// Which of the 84 mini chapels light up in the grid (a fixed pattern, so the page is the same every time).
const lit = (d: number, m: number) => (d * 5 + m * 7) % 9 < 5;
---
<Base>
  <!-- ═══ Hero: one flat block of the brand green ═══ -->
  <section class="bg-brand text-white">
    <div class="container-page grid items-center gap-14 py-16 sm:py-24 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <h1 class="h-display reveal">Know every member. Follow up every visitor.</h1>
        <p class="reveal reveal-delay-1 mt-6 max-w-xl text-lg leading-relaxed text-white/85 sm:text-xl">
          Church management built around how churches here run: day-born chapels and shepherds, first-timers and
          visitation, attendance, programmes and SMS.
        </p>
        <div class="reveal reveal-delay-2 mt-9 flex flex-wrap items-center gap-3">
          <a href="/request-access" class="btn btn-accent">Request access <span class="arrow">→</span></a>
          <a href="/features" class="btn border-2 border-white text-white hover:bg-white hover:text-ink">See how it works</a>
        </div>
        <p class="reveal reveal-delay-2 mt-6 text-sm text-white/75">Free for churches under 100 members. No card needed.</p>
      </div>

      <div class="reveal reveal-delay-1 relative mx-auto w-full max-w-[34rem] pb-10 sm:pb-0">
        <img src={unsplash(PHOTOS.joy.id, 900, 1000)} alt={PHOTOS.joy.alt} width="900" height="1000" class="h-[26rem] w-full rounded-xl object-cover sm:h-[32rem]" fetchpriority="high" />
        <!-- One piece of the real thing over the photo: what the visitation team sees. -->
        <div class="absolute -bottom-2 left-4 right-4 rounded-xl bg-white p-4 text-ink sm:-left-8 sm:right-auto sm:w-72">
          <div class="flex items-center justify-between">
            <p class="text-xs font-bold text-accent-dark">Second-timer</p>
            <p class="text-[11px] text-ink-soft">Sunday</p>
          </div>
          <p class="mt-1 font-bold">Esi Quaye came back</p>
          <p class="text-sm text-ink-soft">Visit due Saturday. Nobody has taken it yet.</p>
          <div class="mt-3 flex gap-2"><span class="rounded-md bg-brand px-3 py-1.5 text-xs font-bold text-white">I'll go</span><span class="rounded-md border border-line px-3 py-1.5 text-xs font-bold">Later</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Bento ═══ -->
  <section class="py-24 sm:py-32">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <h2 class="h-section">Built for the way your church already works</h2>
      </div>

      <div class="mt-16 grid gap-5 lg:grid-cols-6">
        <div class="reveal overflow-hidden rounded-xl bg-brand-soft p-7 sm:p-9 lg:col-span-4">
          <h3 class="h-card max-w-md">Every member lands in the right chapel, automatically</h3>
          <p class="mt-3 max-w-lg text-ink-soft">Seven day-born chapels, twelve months each: 84 mini chapels sorted from a birthday. Shepherds see only their own people.</p>
          <div class="mt-8 overflow-x-auto">
            <div class="grid min-w-[26rem] max-w-xl grid-cols-[auto_repeat(12,1fr)] gap-1.5">
              {days.map((d, di) => (
                <>
                  <span class="pr-2 text-[11px] font-medium text-ink-soft">{d}</span>
                  {Array.from({ length: 12 }).map((_, m) => (
                    <span class={`reveal aspect-square rounded-md ${lit(di, m) ? 'bg-brand' : 'bg-brand/15'}`} style={`transition-delay:${(di * 12 + m) * 12}ms`}></span>
                  ))}
                </>
              ))}
            </div>
          </div>
        </div>

        <div class="reveal reveal-delay-1 flex flex-col rounded-xl bg-accent p-7 sm:p-9 lg:col-span-2">
          <h3 class="h-card">First visit to family</h3>
          <p class="mt-3 text-ink/75">A second visit makes a second-timer. The team sees who to visit. A yes makes a member.</p>
          <div class="mt-auto space-y-2 pt-8">
            {[['First visit', 'bg-white'], ['Second visit', 'bg-white'], ['Visited at home', 'bg-white'], ['Member', 'bg-brand text-white']].map(([t, c], i) => (
              <div class={`reveal flex items-center justify-between rounded-lg px-4 py-3 text-sm font-medium ${c}`} style={`transition-delay:${200 + i * 150}ms`}>
                {t}<span>{i < 3 ? '↓' : '✓'}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="reveal relative overflow-hidden rounded-xl bg-ink p-7 text-white sm:p-9 lg:col-span-3">
          <div class="relative z-10 max-w-[16rem]">
            <h3 class="h-card">SMS that reaches everyone</h3>
            <p class="mt-3 text-white/70">To the whole church, a chapel or last Sunday's visitors. See who it reached.</p>
          </div>
          <img src={unsplash(PHOTOS.phone.id, 600, 700)} alt={PHOTOS.phone.alt} loading="lazy" class="absolute -bottom-6 right-0 h-[85%] w-1/2 rounded-tl-xl object-cover opacity-90" />
          <div class="relative z-10 mt-10 max-w-[15rem] rounded-lg rounded-bl-md bg-white p-3 text-xs text-ink">
            <b>GRACECHAPEL:</b> Happy birthday, Abena! Your church family is praying for you today.
          </div>
        </div>

        <div class="reveal reveal-delay-1 flex flex-col justify-between rounded-xl bg-brand p-7 text-white sm:p-9 lg:col-span-3">
          <div>
            <h3 class="h-card">Your church, at its own address</h3>
            <p class="mt-3 text-white/80">Your name, logo and colours on every page, at your own address. Use your own domain if you have one.</p>
          </div>
          <div class="mt-8 flex items-center gap-3 rounded-lg bg-white px-5 py-3.5 font-mono text-sm text-ink">
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-brand" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
            <span><b class="text-brand-dark">yourchurch</b>.careconnect.com</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Feature tabs ═══ -->
  <section class="bg-mist py-24 sm:py-32">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <h2 class="h-section">Everything your church office does, in one place</h2>
      </div>
      <div class="mt-14"><FeatureTabs /></div>
    </div>
  </section>

  <!-- ═══ Photo band ═══ -->
  <section class="relative isolate overflow-hidden">
    <img src={unsplash(PHOTOS.worship.id, 2000, 900)} alt={PHOTOS.worship.alt} loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/90 via-ink/70 to-ink/20"></div>
    <div class="container-page py-28 sm:py-36">
      <div class="reveal max-w-2xl text-white">
        <p class="h-section">
          Built alongside a church in Accra that runs on it every week.
        </p>
        <a href="/features" class="btn btn-light mt-10">See everything it does <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═══ Numbers (facts about the product, not claims about customers) ═══ -->
  <section class="py-20">
    <div class="container-page grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
      {[[84, 'mini chapels, sorted for you'], [12, 'tools in one system'], [1, 'address of its own, per church'], [100, 'members free, forever']].map(([n, l], i) => (
        <div class={`reveal reveal-delay-${i}`}>
          <p class="font-display text-7xl font-extrabold tracking-[-0.04em] text-brand" data-count={n}>0</p>
          <p class="mt-2 text-ink-soft">{l}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ How it works ═══ -->
  <section class="bg-ink py-24 text-white sm:py-32">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <h2 class="h-section">Up and running in four steps</h2>
      </div>
      <ol class="relative mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div aria-hidden="true" class="absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-accent/0 via-accent/60 to-accent/0 lg:block"></div>
        {STEPS.map((s, i) => (
          <li class={`reveal reveal-delay-${i} relative rounded-xl border border-white/10 bg-white/5 p-7 transition-colors hover:bg-white/10`}>
            <span class="flex h-14 w-14 items-center justify-center rounded-lg bg-accent font-display text-2xl font-extrabold text-ink">{i + 1}</span>
            <h3 class="mt-6 text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 leading-relaxed text-white/70">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ Pricing ═══ -->
  <section class="py-24 sm:py-32">
    <div class="container-page">
      <div class="reveal mx-auto max-w-3xl text-center">
        <h2 class="h-section">Priced in cedis, by the size of your church</h2>
        <p class="lede mt-5">Free under 100 members. Pay a year ahead and get two months free.</p>
      </div>
      <div class="reveal mt-14"><PlanCards /></div>
    </div>
  </section>

  <!-- ═══ Security ═══ -->
  <section class="pb-24">
    <div class="container-page">
      <div class="reveal grid items-center gap-10 overflow-hidden rounded-xl bg-brand-soft p-8 sm:p-14 lg:grid-cols-[1.2fr_1fr]">
        <div>
          <h2 class="h-section">Your church's data stays yours</h2>
          <p class="lede mt-5">Every church has its own address, people and records, kept apart on every request. Roles decide who sees what, every change is logged, and you can export everything at any time.</p>
          <a href="/security" class="btn btn-primary mt-8">How we protect it <span class="arrow">→</span></a>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {[['Kept apart', 'No church sees another'], ['Role-based', 'Shepherds see their chapel'], ['Logged', 'Every change recorded'], ['Exportable', 'Your data, any time']].map(([t, b], i) => (
            <div class={`reveal reveal-delay-${i} rounded-xl bg-white p-5`}>
              <svg viewBox="0 0 24 24" class="h-6 w-6 text-brand" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.4 3.4 8.2 8 9 4.6-.8 8-4.6 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg>
              <p class="mt-3 font-semibold">{t}</p>
              <p class="text-sm text-ink-soft">{b}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="pb-28">
    <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <h2 class="h-section">What churches ask us</h2>
        <p class="mt-5 text-ink-soft">Something else? <a class="font-semibold text-brand underline decoration-accent underline-offset-4" href="/request-access">Ask us directly</a>.</p>
        <img src={unsplash(PHOTOS.family.id, 700, 520)} alt={PHOTOS.family.alt} loading="lazy" class="mt-10 hidden h-64 w-full rounded-xl object-cover lg:block" />
      </div>
      <div class="reveal reveal-delay-1"><Faq /></div>
    </div>
  </section>
</Base>
