---
import Base from '../layouts/Base.astro';
import PlanCards from '../components/PlanCards.astro';
import Faq from '../components/Faq.astro';
import FeatureTabs from '../components/FeatureTabs.astro';
import { STEPS } from '../data/site';
import { PHOTOS, unsplash } from '../data/images';

const words = ['member.', 'visitor.', 'first-timer.', 'family.'];
// One card per word, in the same order: the card on the photo changes with the headline.
const cards = [
  { tag: 'New member', initials: 'KM', tone: 'bg-accent', title: 'Kwame Mensah joined', body: 'Added to the Youth cell. Ama, his leader, has been told.', action: 'Welcome him' },
  { tag: 'Second-timer', initials: 'GM', tone: 'bg-ink text-white', title: 'Grace Mwangi came back', body: 'Visit due Saturday. Nobody has taken it yet.', action: "I'll go" },
  { tag: 'First-timer', initials: 'DO', tone: 'bg-mist', title: 'Daniel Okafor scanned in', body: 'Registered from the QR code at the door. Said yes to membership.', action: 'Call him' },
  { tag: 'Family', initials: 'JF', tone: 'bg-accent-soft', title: 'The Johnson family', body: 'Sarah, Michael and their two children, linked in one household.', action: 'Send a note' },
];
const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
// Which of the 84 mini chapels light up in the grid (a fixed pattern, so the page is the same every time).
const lit = (d: number, m: number) => (d * 5 + m * 7) % 9 < 5;
---
<Base>
  <!-- ═══ Hero: plain white, black type. The word on gold and the card on the photo change together. ═══ -->
  <section class="overflow-hidden bg-white">
    <div class="container-page grid items-center gap-16 pb-20 pt-12 sm:pt-16 lg:grid-cols-[1.08fr_1fr] lg:pb-28">
      <div>
        <h1 class="reveal font-display text-[3rem] font-extrabold leading-[1] tracking-[-0.045em] sm:text-7xl lg:text-[5.4rem]">
          Care for every<br />
          <span class="rotator" data-rotate>
            {words.map((w, i) => <span class={`rounded-2xl bg-accent px-3 pb-1 ${i === 0 ? 'on' : ''}`}>{w}</span>)}
          </span>
        </h1>
        <p class="lede reveal reveal-delay-2 mt-7 max-w-xl">
          Members and groups, first-timers and visitation, attendance, programmes, SMS and email.
          One simple system for the whole of church life.
        </p>

        <!-- Start with the church's name; the request form picks it up. -->
        <form action="/request-access" method="get" class="reveal reveal-delay-3 mt-9 flex max-w-xl flex-col gap-2 rounded-xl border-2 border-ink p-1.5 sm:flex-row">
          <label class="sr-only" for="hero-church">Your church's name</label>
          <input id="hero-church" name="church" maxlength="120" placeholder="Your church's name" autocomplete="organization"
            class="min-w-0 flex-1 rounded-lg bg-transparent px-4 py-3 text-base outline-none placeholder:text-ink-soft/70" />
          <button class="btn btn-primary" type="submit">Get started free <span class="arrow">→</span></button>
        </form>
        <ul class="reveal reveal-delay-3 mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-ink-soft">
          {['Free under 100 members', 'Your own web address', 'Email and SMS built in'].map((t) => (
            <li class="flex items-center gap-2">
              <svg viewBox="0 0 20 20" class="h-4 w-4 text-ink" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10 4 4 8-8" /></svg>{t}
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-art relative mx-auto w-full max-w-[34rem]">
        <!-- A flat gold block, set off behind the photo. -->
        <div aria-hidden="true" class="absolute -right-4 -top-4 bottom-10 left-10 rounded-2xl bg-accent sm:-right-6 sm:-top-6"></div>
        <img src={unsplash(PHOTOS.joy.id, 900, 1000)} alt={PHOTOS.joy.alt} width="900" height="1000" class="relative h-[26rem] w-full rounded-2xl object-cover sm:h-[33rem]" fetchpriority="high" />

        <!-- Live this morning: counts up while you watch. -->
        <div class="hero-pop absolute -left-3 top-8 rounded-xl bg-ink px-4 py-3 text-white sm:-left-10" style="--d:0.5s">
          <p class="flex items-center gap-2 text-[11px] font-semibold text-white/70"><span class="h-2 w-2 animate-pulse rounded-full bg-accent"></span>Checked in this morning</p>
          <p class="mt-0.5 font-display text-3xl font-extrabold tracking-[-0.03em]" data-live="412">412</p>
        </div>

        <!-- The card that changes with the word. -->
        <div class="hero-pop absolute -bottom-6 left-4 right-4 sm:-left-12 sm:right-auto sm:w-80" style="--d:0.75s">
          <div class="rotator w-full" data-rotate>
            {cards.map((c, i) => (
              <div class={`w-full rounded-xl border border-line bg-white p-4 ${i === 0 ? 'on' : ''}`}>
                <div class="flex items-center gap-3">
                  <span class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-xs font-bold ${c.tone}`}>{c.initials}</span>
                  <div class="min-w-0 flex-1">
                    <p class="text-[11px] font-bold uppercase tracking-wide text-accent-dark">{c.tag}</p>
                    <p class="truncate font-bold">{c.title}</p>
                  </div>
                </div>
                <p class="mt-2 text-sm text-ink-soft">{c.body}</p>
                <div class="mt-3 flex gap-2"><span class="rounded-md bg-ink px-3 py-1.5 text-xs font-bold text-white">{c.action}</span><span class="rounded-md border border-line px-3 py-1.5 text-xs font-bold">Later</span></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Bento ═══ -->
  <section class="py-24 sm:py-32">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <h2 class="h-section">Built for the way your church already works</h2>
      </div>

      <div class="mt-16 grid gap-5 lg:grid-cols-6">
        <div class="reveal overflow-hidden rounded-xl bg-brand-soft p-7 sm:p-9 lg:col-span-4">
          <h3 class="h-card max-w-md">Every member in the right group, automatically</h3>
          <p class="mt-3 max-w-lg text-ink-soft">Groups, cells, ministries and chapels, each with leaders who see only their own people. Churches with day-born chapels get all 84 sorted from a birthday.</p>
          <div class="mt-8 overflow-x-auto">
            <div class="grid min-w-[26rem] max-w-xl grid-cols-[auto_repeat(12,1fr)] gap-1.5">
              {days.map((d, di) => (
                <>
                  <span class="pr-2 text-[11px] font-medium text-ink-soft">{d}</span>
                  {Array.from({ length: 12 }).map((_, m) => (
                    <span class={`reveal aspect-square rounded-md ${lit(di, m) ? 'bg-accent' : 'bg-ink/10'}`} style={`transition-delay:${(di * 12 + m) * 12}ms`}></span>
                  ))}
                </>
              ))}
            </div>
          </div>
        </div>

        <div class="reveal reveal-delay-1 flex flex-col rounded-xl bg-accent p-7 sm:p-9 lg:col-span-2">
          <h3 class="h-card">First visit to family</h3>
          <p class="mt-3 text-ink/75">A second visit makes a second-timer. The team sees who to visit. A yes makes a member.</p>
          <div class="mt-auto space-y-2 pt-8">
            {[['First visit', 'bg-white'], ['Second visit', 'bg-white'], ['Visited at home', 'bg-white'], ['Member', 'bg-brand text-white']].map(([t, c], i) => (
              <div class={`reveal flex items-center justify-between rounded-lg px-4 py-3 text-sm font-medium ${c}`} style={`transition-delay:${200 + i * 150}ms`}>
                {t}<span>{i < 3 ? '↓' : '✓'}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="reveal relative overflow-hidden rounded-xl bg-ink p-7 text-white sm:p-9 lg:col-span-3">
          <div class="relative z-10 max-w-[16rem]">
            <h3 class="h-card">SMS that reaches everyone</h3>
            <p class="mt-3 text-white/70">To the whole church, a chapel or last Sunday's visitors. See who it reached.</p>
          </div>
          <img src={unsplash(PHOTOS.phone.id, 600, 700)} alt={PHOTOS.phone.alt} loading="lazy" class="absolute -bottom-6 right-0 h-[85%] w-1/2 rounded-tl-xl object-cover opacity-90" />
          <div class="relative z-10 mt-10 max-w-[15rem] rounded-lg rounded-bl-md bg-white p-3 text-xs text-ink">
            <b>GRACECHAPEL:</b> Happy birthday, Abena! Your church family is praying for you today.
          </div>
        </div>

        <div class="reveal reveal-delay-1 flex flex-col justify-between rounded-xl bg-brand-soft p-7 sm:p-9 lg:col-span-3">
          <div>
            <h3 class="h-card">Your church, at its own address</h3>
            <p class="mt-3 text-ink-soft">Your name, logo and colours on every page, at your own address. Use your own domain if you have one.</p>
          </div>
          <div class="mt-8 flex items-center gap-3 rounded-lg bg-white px-5 py-3.5 font-mono text-sm text-ink">
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-brand" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
            <span><b class="rounded bg-accent px-1">yourchurch</b>.careconnect.com</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Feature tabs ═══ -->
  <section class="bg-mist py-24 sm:py-32">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <h2 class="h-section">Everything your church office does, in one place</h2>
      </div>
      <div class="mt-14"><FeatureTabs /></div>
    </div>
  </section>

  <!-- ═══ Photo band ═══ -->
  <section class="relative isolate overflow-hidden">
    <img src={unsplash(PHOTOS.worship.id, 2000, 900)} alt={PHOTOS.worship.alt} loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/90 via-ink/70 to-ink/20"></div>
    <div class="container-page py-28 sm:py-36">
      <div class="reveal max-w-2xl text-white">
        <p class="h-section">
          Built inside a working church. Used by it every Sunday.
        </p>
        <a href="/features" class="btn btn-light mt-10">See everything it does <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═══ Numbers (facts about the product, not claims about customers) ═══ -->
  <section class="py-20">
    <div class="container-page grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
      {[[84, 'chapels sorted from a birthday'], [12, 'tools in one system'], [1, 'address of its own, per church'], [100, 'members free, forever']].map(([n, l], i) => (
        <div class={`reveal reveal-delay-${i}`}>
          <p class="font-display text-7xl font-extrabold tracking-[-0.04em] text-brand" data-count={n}>0</p>
          <p class="mt-2 text-ink-soft">{l}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ How it works ═══ -->
  <section class="bg-ink py-24 text-white sm:py-32">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <h2 class="h-section">Up and running in four steps</h2>
      </div>
      <ol class="relative mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div aria-hidden="true" class="absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-accent/0 via-accent/60 to-accent/0 lg:block"></div>
        {STEPS.map((s, i) => (
          <li class={`reveal reveal-delay-${i} relative rounded-xl border border-white/10 bg-white/5 p-7 transition-colors hover:bg-white/10`}>
            <span class="flex h-14 w-14 items-center justify-center rounded-lg bg-accent font-display text-2xl font-extrabold text-ink">{i + 1}</span>
            <h3 class="mt-6 text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 leading-relaxed text-white/70">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ Pricing ═══ -->
  <section class="py-24 sm:py-32">
    <div class="container-page">
      <div class="reveal mx-auto max-w-3xl text-center">
        <h2 class="h-section">Priced by the size of your church</h2>
        <p class="lede mt-5">Free under 100 members. Pay a year ahead and get two months free.</p>
      </div>
      <div class="reveal mt-14"><PlanCards /></div>
    </div>
  </section>

  <!-- ═══ Security ═══ -->
  <section class="pb-24">
    <div class="container-page">
      <div class="reveal grid items-center gap-10 overflow-hidden rounded-xl bg-brand-soft p-8 sm:p-14 lg:grid-cols-[1.2fr_1fr]">
        <div>
          <h2 class="h-section">Your church's data stays yours</h2>
          <p class="lede mt-5">Every church has its own address, people and records, kept apart on every request. Roles decide who sees what, every change is logged, and you can export everything at any time.</p>
          <a href="/security" class="btn btn-primary mt-8">How we protect it <span class="arrow">→</span></a>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {[['Kept apart', 'No church sees another'], ['Role-based', 'Shepherds see their chapel'], ['Logged', 'Every change recorded'], ['Exportable', 'Your data, any time']].map(([t, b], i) => (
            <div class={`reveal reveal-delay-${i} rounded-xl bg-white p-5`}>
              <svg viewBox="0 0 24 24" class="h-6 w-6 text-brand" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.4 3.4 8.2 8 9 4.6-.8 8-4.6 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg>
              <p class="mt-3 font-semibold">{t}</p>
              <p class="text-sm text-ink-soft">{b}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="pb-28">
    <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <h2 class="h-section">What churches ask us</h2>
        <p class="mt-5 text-ink-soft">Something else? <a class="font-semibold text-brand underline decoration-accent underline-offset-4" href="/request-access">Ask us directly</a>.</p>
        <img src={unsplash(PHOTOS.family.id, 700, 520)} alt={PHOTOS.family.alt} loading="lazy" class="mt-10 hidden h-64 w-full rounded-xl object-cover lg:block" />
      </div>
      <div class="reveal reveal-delay-1"><Faq /></div>
    </div>
  </section>
</Base>
