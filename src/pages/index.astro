---
import Base from '../layouts/Base.astro';
import PlanCards from '../components/PlanCards.astro';
import Faq from '../components/Faq.astro';
import FeatureTabs from '../components/FeatureTabs.astro';
import Squiggle from '../components/Squiggle.astro';
import { STEPS } from '../data/site';
import { PHOTOS, unsplash } from '../data/images';

const marquee = ['Day-born chapels', 'Chapel shepherds', 'First-timer QR codes', 'Second-timer visits', 'Drift alerts', 'Kiosk check-in',
  'Bulk SMS', 'Birthday greetings', 'Events and registrations', 'Custom forms', 'Membership classes', 'Certificates', 'Campus outreach', 'AI assistant', 'Members map'];
const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
// Which of the 84 mini chapels light up in the grid (a fixed pattern, so the page is the same every time).
const lit = (d: number, m: number) => (d * 5 + m * 7) % 9 < 5;
---
<Base>
  <!-- ═══ Hero ═══ -->
  <section class="relative overflow-hidden bg-cream">
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-accent/25 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-48 -left-32 h-[30rem] w-[30rem] rounded-full bg-brand/15 blur-3xl"></div>
    <div class="container-page relative grid items-center gap-14 pb-20 pt-14 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:pb-28">
      <div>
        <p class="eyebrow reveal">
          <span class="rounded-full bg-brand-soft px-3 py-1 normal-case tracking-normal text-brand-dark">Church management, made in Ghana</span>
        </p>
        <h1 class="h-display reveal reveal-delay-1 mt-6">
          Care for every<br />
          <span class="rotator accent-word">
            <span class="on">member.</span><span>visitor.</span><span>first-timer.</span><span>family.</span>
          </span>
        </h1>
        <p class="lede reveal reveal-delay-2 mt-6 max-w-xl">
          CareConnect is built for how African churches actually run: day-born chapels and shepherds, first-timers and
          visitation, attendance, programmes, and SMS that reaches everyone. One simple system.
        </p>
        <div class="reveal reveal-delay-3 mt-9 flex flex-wrap items-center gap-3">
          <a href="/request-access" class="btn btn-primary">Request access <span class="arrow">→</span></a>
          <a href="/features" class="btn btn-ghost">See how it works</a>
        </div>
        <p class="reveal reveal-delay-3 mt-6 text-sm text-ink-soft">Free for churches under 100 members. No card needed.</p>
      </div>

      <!-- Photo with the product floating over it -->
      <div class="reveal reveal-delay-2 relative mx-auto w-full max-w-[34rem]">
        <svg aria-hidden="true" viewBox="0 0 120 120" class="absolute -left-10 -top-8 h-24 w-24 text-accent animate-spin-slow"><path fill="currentColor" d="M60 0l6 46 46-6-40 20 40 20-46-6-6 46-6-46-46 6 40-20-40-20 46 6z" opacity=".85" /></svg>
        <div class="relative overflow-hidden rounded-[2.5rem] rotate-[1.5deg] shadow-[0_40px_80px_-40px_rgba(16,35,42,0.6)]">
          <img src={unsplash(PHOTOS.joy.id, 900, 1050)} alt={PHOTOS.joy.alt} width="900" height="1050" class="h-[30rem] w-full object-cover sm:h-[34rem]" fetchpriority="high" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/30 via-transparent to-transparent"></div>
        </div>

        <div class="absolute -left-6 top-16 w-60 rounded-2xl bg-white p-4 shadow-[0_20px_40px_-20px_rgba(16,35,42,0.45)] animate-float sm:-left-14">
          <div class="flex items-center gap-2"><span class="rounded-full bg-accent-soft px-2 py-0.5 text-[11px] font-semibold text-accent-dark">Second-timer</span><span class="text-[11px] text-ink-soft">just now</span></div>
          <p class="mt-2 text-sm font-semibold">Esi Quaye came back</p>
          <p class="text-xs text-ink-soft">A visit is due on Saturday</p>
          <div class="mt-3 flex gap-1.5"><span class="rounded-full bg-brand px-3 py-1 text-[11px] font-semibold text-white">I'll go</span><span class="rounded-full border border-line px-3 py-1 text-[11px]">Later</span></div>
        </div>

        <div class="absolute -right-4 bottom-24 w-56 rounded-2xl bg-white p-4 shadow-[0_20px_40px_-20px_rgba(16,35,42,0.45)] animate-float-slow [animation-delay:-3s] sm:-right-10">
          <p class="text-[11px] font-semibold text-brand-dark">SMS to all members</p>
          <p class="mt-1 font-display text-3xl font-semibold">1,176</p>
          <p class="text-xs text-ink-soft">delivered of 1,190</p>
          <div class="mt-2 h-2 rounded-full bg-mist"><div class="h-2 w-[98%] rounded-full bg-brand"></div></div>
        </div>

        <div class="absolute -bottom-6 left-8 flex items-center gap-3 rounded-full bg-ink py-2.5 pl-2.5 pr-5 text-white shadow-[0_20px_40px_-20px_rgba(16,35,42,0.7)] animate-float [animation-delay:-1.5s]">
          <div class="flex -space-x-2">
            {['AO', 'KM', 'EB'].map((i, n) => <span class={`flex h-8 w-8 items-center justify-center rounded-full border-2 border-ink text-[10px] font-bold ${['bg-accent text-ink', 'bg-coral', 'bg-brand'][n]}`}>{i}</span>)}
          </div>
          <p class="text-sm"><b>37</b> first-timers this month</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Marquee ═══ -->
  <section class="border-y border-line bg-white py-5" aria-label="What CareConnect does">
    <div class="marquee-mask overflow-hidden">
      <div class="flex w-max animate-marquee gap-3 hover:[animation-play-state:paused]">
        {[...marquee, ...marquee].map((m, i) => (
          <span class="flex items-center gap-3 whitespace-nowrap rounded-full border border-line px-5 py-2 text-sm font-medium" aria-hidden={i >= marquee.length ? 'true' : undefined}>
            <svg viewBox="0 0 20 20" class="h-4 w-4 text-accent" fill="currentColor"><path d="M10 0l2.4 7.6L20 10l-7.6 2.4L10 20l-2.4-7.6L0 10l7.6-2.4z" /></svg>{m}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Bento ═══ -->
  <section class="py-24 sm:py-32">
    <div class="container-page">
      <div class="reveal mx-auto max-w-3xl text-center">
        <p class="eyebrow">Why churches choose CareConnect</p>
        <h2 class="h-section mt-4">Care that doesn't depend on <Squiggle>someone remembering</Squiggle></h2>
      </div>

      <div class="mt-16 grid gap-5 lg:grid-cols-6">
        <div class="reveal lift card overflow-hidden bg-cream p-7 sm:p-9 lg:col-span-4">
          <p class="eyebrow">Members and chapels</p>
          <h3 class="h-card mt-3 max-w-md">Every member lands in the right chapel, automatically</h3>
          <p class="mt-3 max-w-lg text-ink-soft">Seven day-born chapels, twelve months each: 84 mini chapels sorted from a birthday. Shepherds see only their own people.</p>
          <div class="mt-8 overflow-x-auto">
            <div class="grid min-w-[26rem] max-w-xl grid-cols-[auto_repeat(12,1fr)] gap-1.5">
              {days.map((d, di) => (
                <>
                  <span class="pr-2 text-[11px] font-medium text-ink-soft">{d}</span>
                  {Array.from({ length: 12 }).map((_, m) => (
                    <span class={`reveal aspect-square rounded-md ${lit(di, m) ? 'bg-brand' : 'bg-brand/15'}`} style={`transition-delay:${(di * 12 + m) * 12}ms`}></span>
                  ))}
                </>
              ))}
            </div>
          </div>
        </div>

        <div class="reveal reveal-delay-1 lift card flex flex-col bg-brand-soft p-7 sm:p-9 lg:col-span-2">
          <p class="eyebrow">Visitors</p>
          <h3 class="h-card mt-3">First visit to family</h3>
          <p class="mt-3 text-ink-soft">A second visit makes a second-timer. The team sees who to visit. A yes makes a member.</p>
          <div class="mt-auto space-y-2 pt-8">
            {[['First visit', 'bg-white'], ['Second visit', 'bg-white'], ['Visited at home', 'bg-white'], ['Member', 'bg-brand text-white']].map(([t, c], i) => (
              <div class={`reveal flex items-center justify-between rounded-2xl px-4 py-3 text-sm font-medium ${c}`} style={`transition-delay:${200 + i * 150}ms`}>
                {t}<span>{i < 3 ? '↓' : '✓'}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="reveal lift relative overflow-hidden rounded-3xl bg-ink p-7 text-white sm:p-9 lg:col-span-3">
          <div class="relative z-10 max-w-[16rem]">
            <p class="eyebrow !text-accent">Messages</p>
            <h3 class="h-card mt-3">SMS that reaches everyone</h3>
            <p class="mt-3 text-white/70">To the whole church, a chapel or last Sunday's visitors. See who it reached.</p>
          </div>
          <img src={unsplash(PHOTOS.phone.id, 600, 700)} alt={PHOTOS.phone.alt} loading="lazy" class="absolute -bottom-6 right-0 h-[85%] w-1/2 rounded-tl-[2rem] object-cover opacity-90" />
          <div class="relative z-10 mt-10 max-w-[15rem] rounded-2xl rounded-bl-md bg-white p-3 text-xs text-ink shadow-xl animate-float">
            <b>GRACECHAPEL:</b> Happy birthday, Abena! Your church family is praying for you today.
          </div>
        </div>

        <div class="reveal reveal-delay-1 lift card flex flex-col justify-between bg-accent-soft p-7 sm:p-9 lg:col-span-3">
          <div>
            <p class="eyebrow">Ready in a day</p>
            <h3 class="h-card mt-3">Your church, at its own address</h3>
            <p class="mt-3 text-ink-soft">Your name, logo and colours on every page, at your own address. Use your own domain if you have one.</p>
          </div>
          <div class="mt-8 flex items-center gap-3 rounded-full bg-white px-5 py-3.5 font-mono text-sm shadow-[0_12px_30px_-18px_rgba(16,35,42,0.5)]">
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-brand" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
            <span><b class="text-brand-dark">yourchurch</b>.careconnect.com</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Feature tabs ═══ -->
  <section class="bg-mist py-24 sm:py-32">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow">Everything in one place</p>
        <h2 class="h-section mt-4">One system for the <span class="accent-word">whole</span> of church life</h2>
      </div>
      <div class="mt-14"><FeatureTabs /></div>
    </div>
  </section>

  <!-- ═══ Photo band ═══ -->
  <section class="relative isolate overflow-hidden">
    <img src={unsplash(PHOTOS.worship.id, 2000, 900)} alt={PHOTOS.worship.alt} loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/90 via-ink/70 to-ink/20"></div>
    <div class="container-page py-28 sm:py-36">
      <div class="reveal max-w-2xl text-white">
        <p class="eyebrow !text-accent">Built with a working church</p>
        <p class="mt-5 font-display text-4xl font-medium leading-tight sm:text-5xl">
          Shaped Sunday after Sunday with a church in Accra, for churches <span class="italic text-accent">across Africa</span>.
        </p>
        <a href="/features" class="btn btn-light mt-10">See everything it does <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ═══ Numbers (facts about the product, not claims about customers) ═══ -->
  <section class="py-20">
    <div class="container-page grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
      {[[84, 'mini chapels, sorted for you'], [12, 'tools in one system'], [1, 'address of its own, per church'], [100, 'members free, forever']].map(([n, l], i) => (
        <div class={`reveal reveal-delay-${i}`}>
          <p class="font-display text-6xl font-medium text-brand" data-count={n}>0</p>
          <p class="mt-2 text-ink-soft">{l}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ How it works ═══ -->
  <section class="bg-ink py-24 text-white sm:py-32">
    <div class="container-page">
      <div class="reveal max-w-3xl">
        <p class="eyebrow !text-accent">How it works</p>
        <h2 class="h-section mt-4">From your first message to your <span class="italic text-accent">first Sunday</span></h2>
      </div>
      <ol class="relative mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div aria-hidden="true" class="absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-accent/0 via-accent/60 to-accent/0 lg:block"></div>
        {STEPS.map((s, i) => (
          <li class={`reveal reveal-delay-${i} relative rounded-3xl border border-white/10 bg-white/5 p-7 transition-colors hover:bg-white/10`}>
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-accent font-display text-2xl font-semibold text-ink">{i + 1}</span>
            <h3 class="mt-6 text-xl font-semibold">{s.title}</h3>
            <p class="mt-2 leading-relaxed text-white/70">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ Pricing ═══ -->
  <section class="py-24 sm:py-32">
    <div class="container-page">
      <div class="reveal mx-auto max-w-3xl text-center">
        <p class="eyebrow">Pricing</p>
        <h2 class="h-section mt-4">Priced in cedis, by the <span class="accent-word">size</span> of your church</h2>
        <p class="lede mt-5">Start free. Grow when you're ready. Pay a year ahead and get two months free.</p>
      </div>
      <div class="reveal mt-14"><PlanCards /></div>
    </div>
  </section>

  <!-- ═══ Security ═══ -->
  <section class="pb-24">
    <div class="container-page">
      <div class="reveal grid items-center gap-10 overflow-hidden rounded-[2.5rem] bg-brand-soft p-8 sm:p-14 lg:grid-cols-[1.2fr_1fr]">
        <div>
          <p class="eyebrow">Security</p>
          <h2 class="h-section mt-4">Your church's data stays <span class="accent-word">yours</span></h2>
          <p class="lede mt-5">Every church has its own address, people and records, kept apart on every request. Roles decide who sees what, every change is logged, and you can export everything at any time.</p>
          <a href="/security" class="btn btn-primary mt-8">How we protect it <span class="arrow">→</span></a>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {[['Kept apart', 'No church sees another'], ['Role-based', 'Shepherds see their chapel'], ['Logged', 'Every change recorded'], ['Exportable', 'Your data, any time']].map(([t, b], i) => (
            <div class={`reveal reveal-delay-${i} rounded-3xl bg-white p-5`}>
              <svg viewBox="0 0 24 24" class="h-6 w-6 text-brand" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.4 3.4 8.2 8 9 4.6-.8 8-4.6 8-9V6z" /><path d="m9 12 2 2 4-4" /></svg>
              <p class="mt-3 font-semibold">{t}</p>
              <p class="text-sm text-ink-soft">{b}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="pb-28">
    <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <p class="eyebrow">Questions</p>
        <h2 class="h-section mt-4">What churches ask us</h2>
        <p class="mt-5 text-ink-soft">Something else? <a class="font-semibold text-brand underline decoration-accent underline-offset-4" href="/request-access">Ask us directly</a>.</p>
        <img src={unsplash(PHOTOS.family.id, 700, 520)} alt={PHOTOS.family.alt} loading="lazy" class="mt-10 hidden h-64 w-full rounded-[2rem] object-cover lg:block" />
      </div>
      <div class="reveal reveal-delay-1"><Faq /></div>
    </div>
  </section>
</Base>
