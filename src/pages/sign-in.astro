---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="Sign in" description="Sign in to your church on CareConnect.">
  <section class="bg-gradient-to-b from-brand-soft/70 to-white">
    <div class="container-page flex min-h-[70vh] items-center justify-center py-16">
      <div class="card w-full max-w-md p-8">
        <h1 class="text-2xl font-extrabold">Sign in to your church</h1>
        <p class="mt-2 text-sm text-ink-soft">Each church on CareConnect has its own address. Enter your church's web name and we'll take you there.</p>
        <form id="go" class="mt-6">
          <label class="text-sm font-semibold" for="slug">Your church's web name</label>
          <div class="mt-1.5 flex items-center rounded-xl border border-line focus-within:border-brand focus-within:ring-2 focus-within:ring-brand/15">
            <input id="slug" name="slug" required autocapitalize="none" autocomplete="off" spellcheck="false" placeholder="gracechapel" class="min-w-0 flex-1 rounded-l-xl bg-transparent px-4 py-3 text-sm outline-none" />
            <span class="pr-4 text-sm text-ink-soft">.{SITE.appDomain}</span>
          </div>
          <p id="go-error" class="mt-2 hidden text-sm text-rose-700">Use letters, numbers and dashes only.</p>
          <button class="btn btn-primary mt-5 w-full" type="submit">Continue</button>
        </form>
        <p class="mt-6 text-sm text-ink-soft">Not sure of the name? It's in the invitation email you received, or ask your church's administrator. Your church uses its own domain? Sign in there.</p>
        <p class="mt-4 text-sm">New to CareConnect? <a class="font-semibold text-brand hover:underline" href="/request-access">Request access</a></p>
      </div>
    </div>
  </section>
</Base>
<script define:vars={{ domain: SITE.appDomain }}>
  const form = document.getElementById('go');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const slug = form.elements.slug.value.trim().toLowerCase().replace(/\.careconnect\.com.*$/, '');
    if (!/^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$/.test(slug)) { document.getElementById('go-error').classList.remove('hidden'); return; }
    location.href = `https://${slug}.${domain}/login`;
  });
</script>
