---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
        <p class="font-display text-[7rem] italic leading-none text-accent-dark">404</p>
    <h1 class="h-section mt-4">We couldn't find that page</h1>
    <p class="lede mt-4">It may have moved. Here are some places to start.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3"><a href="/" class="btn btn-primary">Home</a><a href="/features" class="btn btn-ghost">Features</a><a href="/sign-in" class="btn btn-ghost">Sign in to your church</a></div>
  </section>
</Base>
