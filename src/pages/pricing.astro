---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlanCards from '../components/PlanCards.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { PLANS, SMS_BUNDLES } from '../data/site';
import { PHOTOS, unsplash } from '../data/images';
const paid = PLANS.filter((p) => p.monthly);
const promises = ['Free under 100 members', 'Priced by church size, never per user', 'Two months free when you pay yearly', 'Mobile money, bank or card'];
---
<Base title="Pricing" description="CareConnect pricing in cedis: free for churches under 100 members, then by the size of your church. SMS bundles priced per unit.">
  <PageHero eyebrow="Pricing" lede="Free for small churches. After that you pay by the size of your congregation, never per user. Pay monthly by card, or a year ahead by mobile money and get two months free.">
    Simple pricing, in <span class="accent-word">cedis</span>
    <ul slot="after" class="mt-9 flex flex-wrap justify-center gap-2">
      {promises.map((p) => (
        <li class="flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2 text-sm">
          <svg viewBox="0 0 20 20" class="h-4 w-4 text-brand" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10 4 4 8-8" /></svg>{p}
        </li>
      ))}
    </ul>
  </PageHero>

  <section class="relative -mt-2 pb-20 pt-16">
    <div class="container-page">
      <div class="reveal"><PlanCards /></div>
      <div class="reveal mt-8 flex flex-col gap-4 rounded-3xl bg-accent-soft p-7 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-display text-2xl font-medium">Paying a year ahead?</p>
          <p class="mt-1 text-sm text-ink-soft">A year costs the price of ten months. Mobile money, bank transfer or card.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          {paid.map((p) => (
            <div class="rounded-2xl bg-white px-5 py-3">
              <p class="text-xs text-ink-soft">{p.name}, a year</p>
              <p class="font-display text-xl font-medium">GHS {((p.monthly ?? 0) * 10).toLocaleString('en-GH')}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="sms" class="relative scroll-mt-24 overflow-hidden bg-ink py-24 text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full bg-brand/40 blur-3xl"></div>
    <div class="container-page relative grid gap-14 lg:grid-cols-[1fr_1.15fr] lg:items-center">
      <div class="reveal">
        <p class="eyebrow !text-accent">SMS bundles</p>
        <h2 class="h-section mt-4">Pay only for the messages you <span class="italic text-accent">send</span></h2>
        <p class="mt-5 text-lg text-white/75">Buy SMS units in cedis and top up whenever you like. Every message is counted against your church, and you can see exactly where it went. Large churches can connect their own SMS account instead.</p>
        <img src={unsplash(PHOTOS.phone.id, 900, 520)} alt={PHOTOS.phone.alt} loading="lazy" class="mt-10 hidden h-56 w-full rounded-[2rem] object-cover lg:block" />
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {SMS_BUNDLES.map((b, i) => (
          <div class={`reveal reveal-delay-${i + 1} rounded-3xl p-7 text-center transition duration-300 hover:-translate-y-1 ${i === 1 ? 'bg-accent text-ink' : 'border border-white/10 bg-white/5 hover:bg-white/10'}`}>
            <p class="font-display text-4xl font-medium">{b.units.toLocaleString('en-GH')}</p>
            <p class={`text-sm ${i === 1 ? 'text-ink/70' : 'text-white/60'}`}>SMS units</p>
            <p class="mt-6 text-xl font-semibold">GHS {b.price.toLocaleString('en-GH')}</p>
            <p class={`text-xs ${i === 1 ? 'text-ink/70' : 'text-white/60'}`}>GHS {(b.price / b.units).toFixed(3)} each</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <p class="eyebrow">Questions</p>
        <h2 class="h-section mt-4">About pricing</h2>
        <p class="mt-4 text-ink-soft">Prices shown are our launch prices.</p>
      </div>
      <div class="reveal reveal-delay-1"><Faq /></div>
    </div>
  </section>

  <Cta />
</Base>
