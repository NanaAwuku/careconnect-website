---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlanCards from '../components/PlanCards.astro';
import Faq from '../components/Faq.astro';
import { PLANS } from '../data/site';
import { PHOTOS, unsplash } from '../data/images';
const paid = PLANS.filter((p) => p.monthly);
const promises = ['Free under 100 members', 'Priced by church size, never per user', 'Two months free when you pay yearly', 'Card, bank transfer or mobile money'];
---
<Base title="Pricing" description="CareConnect pricing: free for churches under 100 members, then by the size of your church. SMS bundles priced per unit.">
  <PageHero tone="gold" lede="Free for small churches. After that you pay by the size of your congregation, never per user. Pay monthly by card, or a year ahead and get two months free.">
    Simple pricing that grows with you
    <ul slot="after" class="mt-9 flex flex-wrap gap-2">
      {promises.map((p) => (
        <li class="flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-[13px] font-semibold sm:px-4 sm:py-2.5 sm:text-sm">
          <svg viewBox="0 0 20 20" class="h-4 w-4 text-brand" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10 4 4 8-8" /></svg>{p}
        </li>
      ))}
    </ul>
  </PageHero>

  <section class="relative -mt-2 pb-20 pt-16">
    <div class="container-page">
      <div class="reveal"><PlanCards /></div>
      <div class="reveal mt-8 flex flex-col gap-4 rounded-xl bg-accent-soft p-7 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-display text-2xl font-extrabold tracking-[-0.03em]">Paying a year ahead?</p>
          <p class="mt-1 text-sm text-ink-soft">A year costs the price of ten months. Card, bank transfer or mobile money.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          {paid.map((p) => (
            <div class="rounded-lg bg-white px-5 py-3">
              <p class="text-xs text-ink-soft">{p.name}, a year</p>
              <p class="font-display text-xl font-extrabold tracking-[-0.03em]">${((p.monthly ?? 0) * 10).toLocaleString('en-US')}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="sms" class="relative scroll-mt-24 overflow-hidden bg-ink py-16 sm:py-24 text-white">
    <div class="container-page relative grid gap-14 lg:grid-cols-[1fr_1.15fr] lg:items-center">
      <div class="reveal">
        <h2 class="h-section">Email included. SMS when you need it.</h2>
        <p class="mt-5 text-lg text-white/75">Email to your whole church is part of every paid plan. SMS is pay-as-you-go: buy credit, top up whenever you like, and see exactly where every message went.</p>
        <img src={unsplash(PHOTOS.phone.id, 900, 520)} alt={PHOTOS.phone.alt} loading="lazy" class="mt-10 hidden h-56 w-full rounded-xl object-cover lg:block" />
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {[
          ['Email', 'Included', 'On every paid plan, to members, groups and visitors.'],
          ['SMS credit', 'Pay as you go', 'Priced per message at your country\'s rates. Live in Ghana now, more countries on the way.'],
          ['Your own provider', 'Large churches', 'Connect your own SMS account and send at your own rates.'],
        ].map(([t, big, body], i) => (
          <div class={`reveal reveal-delay-${i + 1} rounded-xl p-7 ${i === 0 ? 'bg-accent text-ink' : 'border border-white/10 bg-white/5'}`}>
            <p class={`text-sm font-semibold ${i === 0 ? 'text-ink/70' : 'text-white/60'}`}>{t}</p>
            <p class="mt-2 font-display text-2xl font-extrabold tracking-[-0.03em]">{big}</p>
            <p class={`mt-4 text-sm leading-relaxed ${i === 0 ? 'text-ink/75' : 'text-white/70'}`}>{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <h2 class="h-section">About pricing</h2>
        <p class="mt-4 text-ink-soft">Prices shown are our launch prices.</p>
      </div>
      <div class="reveal reveal-delay-1"><Faq /></div>
    </div>
  </section>
</Base>
