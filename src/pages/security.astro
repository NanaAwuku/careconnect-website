---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { PHOTOS, unsplash } from '../data/images';
const icons: Record<string, string> = {
  apart: 'M12 3 4 6v6c0 4.4 3.4 8.2 8 9 4.6-.8 8-4.6 8-9V6z M9 12l2 2 4-4',
  roles: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M22 21v-2a4 4 0 0 0-3-3.9 M16 3.1a4 4 0 0 1 0 7.8',
  log: 'M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z M14 3v6h6 M8 13h8 M8 17h5',
  lock: 'M5 11h14v10H5z M8 11V7a4 4 0 0 1 8 0v4',
  key: 'M15 7a3 3 0 1 1-6 0 3 3 0 0 1 6 0z M12 10v11 M12 15h3 M12 18h2',
  export: 'M12 3v12 M7 10l5 5 5-5 M5 21h14',
};
const items = [
  ['apart', 'Every church kept apart', 'Each church has its own address, its own people and its own records. Every request is limited to the church it belongs to, and this is tested on both sides, so one church can never see another\'s members, messages or reports.'],
  ['roles', 'Roles decide who sees what', 'Administrators give each role exactly what it needs. Chapel shepherds see only their chapel; pastor-only notes stay with the pastors.'],
  ['log', 'Every change is logged', 'Who added, changed or removed what, and when, in an activity log your administrators can read.'],
  ['lock', 'Sign-in that is hard to abuse', 'Passwords are never stored, only their hashes. Accounts lock after repeated failed attempts, and set-up links work once and expire within a day.'],
  ['key', 'Keys and secrets encrypted', 'The credentials a church brings, like its SMS account key, are encrypted at rest and never shown again, not even to us.'],
  ['export', 'Your data is yours', 'Export everything your church owns at any time. When you close your account, it is deleted for good.'],
];
---
<Base title="Security" description="How CareConnect keeps each church's data separate, private and in its own hands.">
  <PageHero tone="dark" lede="A church trusts us with its members' names, phone numbers, families and prayer requests. Here is how we look after them.">
    Your church's people are in safe hands
    <div slot="aside" class="relative">
      <img src={unsplash(PHOTOS.family.id, 900, 900)} alt={PHOTOS.family.alt} width="900" height="900" class="h-[26rem] w-full rounded-xl object-cover sm:h-[30rem]" fetchpriority="high" />
      <div class="absolute -left-3 bottom-10 rounded-lg bg-white p-4 text-ink sm:-left-10">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent text-ink">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icons.apart} /></svg>
          </span>
          <div><p class="text-sm font-semibold">Kept apart</p><p class="text-[11px] text-ink-soft">Checked on every request</p></div>
        </div>
      </div>
    </div>
  </PageHero>

  <section class="py-16 sm:py-24">
    <div class="container-page">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {items.map(([icon, t, b], i) => (
          <div class={`card lift reveal reveal-delay-${i % 3} p-8`}>
            <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-brand-soft text-brand-dark">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icons[icon]} /></svg>
            </span>
            <h2 class="h-card mt-6">{t}</h2>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">{b}</p>
          </div>
        ))}
      </div>
      <div class="reveal mt-10 flex flex-col gap-4 rounded-xl bg-accent-soft p-7 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-2xl text-[15px] text-ink-soft">
          Each church owns its data and decides what it records. We handle it under data-protection law, and can sign a data processing agreement with your church.
        </p>
        <a class="btn btn-ghost shrink-0" href="/privacy">Read our privacy policy <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
</Base>
