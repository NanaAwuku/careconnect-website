---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, PLANS } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = SITE.description, noindex = false } = Astro.props;
// The home page's title carries the words people search for; other pages lead with their own subject.
const fullTitle = title ? `${title} | ${SITE.seoName}` : `${SITE.seoName}: Church Management Software for Members, Visitors and Follow-up`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const isHome = Astro.url.pathname === '/';

// Structured data: tells search engines who we are and what CareConnect is, with real prices.
const site = Astro.site!.origin;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.seoName, alternateName: SITE.name, url: `${site}/`, logo: `${site}/icon-512.png`, email: SITE.email },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.seoName, alternateName: SITE.name, url: `${site}/` },
  ...(isHome || Astro.url.pathname.startsWith('/pricing') ? [{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: SITE.seoName,
    applicationCategory: 'BusinessApplication',
    applicationSubCategory: 'Church management software',
    operatingSystem: 'Web browser',
    url: `${site}/`,
    description: SITE.description,
    offers: PLANS.filter((p) => p.monthly !== null).map((p) => ({
      '@type': 'Offer', name: p.name, price: p.monthly, priceCurrency: 'USD', description: p.members,
    })),
  }] : []),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.seoName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CareConnect Church: care for every member and every visitor" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#141414" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />

    <script>
      // Motion, all of it optional: fade into view, the rotating word, counters, feature tabs.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Rise into view as they scroll in (once).
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // The header gains an edge once the page scrolls.
      const header = document.getElementById('site-header');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
      addEventListener('scroll', onScroll, { passive: true }); onScroll();

      // The rotating word, and anything that changes with it: one clock, so they stay together.
      const rotators = [...document.querySelectorAll('[data-rotate]')].map((r) => [...r.children]);
      if (!reduce && rotators.length) {
        let i = 0;
        setInterval(() => {
          rotators.forEach((items) => items[i % items.length].classList.remove('on'));
          i += 1;
          rotators.forEach((items) => items[i % items.length].classList.add('on'));
        }, 2800);
      }

      // A live number that creeps up now and then, like a real Sunday morning.
      document.querySelectorAll<HTMLElement>('[data-live]').forEach((el) => {
        if (reduce) return;
        let n = Number(el.dataset.live);
        setInterval(() => { n += 1 + Math.floor(Math.random() * 3); el.textContent = n.toLocaleString('en-US'); }, 1800);
      });

      // Counters count up once visible.
      const countIo = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          const to = Number(el.dataset.count);
          countIo.unobserve(el);
          if (reduce) { el.textContent = to.toLocaleString('en-US'); continue; }
          const start = performance.now();
          const tick = (t: number) => {
            const p = Math.min(1, (t - start) / 1400);
            el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3))).toLocaleString('en-US');
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      }, { threshold: 0.5 });
      document.querySelectorAll('[data-count]').forEach((el) => countIo.observe(el));

      // Feature tabs: click to choose; they move on by themselves until someone does.
      document.querySelectorAll('[data-tabs]').forEach((root) => {
        const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
        const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
        let current = 0; let timer: number | undefined;
        const show = (i: number) => {
          current = i;
          tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(j === i)); t.classList.toggle('active', j === i); });
          panels.forEach((p, j) => { p.classList.toggle('panel-on', j === i); p.setAttribute('aria-hidden', String(j !== i)); });
        };
        // Move on by themselves only while on screen, and never again once someone has chosen.
        let chosen = false;
        const start = () => { if (!reduce && !chosen && timer === undefined) timer = window.setInterval(() => show((current + 1) % tabs.length), 6000); };
        const stop = () => { clearInterval(timer); timer = undefined; };
        tabs.forEach((t, i) => t.addEventListener('click', () => { chosen = true; stop(); show(i); }));
        new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.3 }).observe(root);
        show(0);
      });
    </script>
  </body>
</html>
